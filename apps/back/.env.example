DB_HOST="localhost"
DB_PORT=5433
DB_USER="starter"
DB_PASSWORD="password"
DB_NAME="starter"

# Local/dev only — use a long random secret in production (Docker secrets).
JWT_KEY="change-me-in-production"

REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD=

FRONT_URL=http://localhost:4000

# Optional. Comma-separated extra CORS origins (localhost 4000/4001 are always allowed).
CORS_ORIGINS=

# Optional cookie domain in production (e.g. .example.com). Leave empty for localhost.
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4001/auth/google/callback"
