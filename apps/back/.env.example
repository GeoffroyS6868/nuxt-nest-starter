DB_HOST="localhost"
DB_PORT=5433
DB_USER="starter"
DB_PASSWORD="password"
DB_NAME="starter"

# Local/dev only. Production requires at least 32 random characters (Docker secrets).
JWT_KEY="change-me-in-production"

REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD=

# Public site origin. Required in production (CORS + OAuth return).
FRONT_URL=http://localhost:4000

# Optional extra CORS origins. Localhost is allowed only in development.
# In production, FRONT_URL is allowed automatically.
CORS_ORIGINS=

# Optional cookie domain in production (e.g. .example.com). Leave empty for localhost.
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4001/auth/google/callback"
